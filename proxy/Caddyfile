(local_security) {
    tls internal

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
        -Server
    }
}

portal.localhost {
    import local_security

    @backend path /api /api/* /swagger /swagger/*

    handle @backend {
        reverse_proxy api-portal:8080 {
            header_up X-Portal-Frontend "APP-PUB"
        }
    }

    handle {
        reverse_proxy app-pub:3000
    }
}

bo.localhost {
    import local_security

    @backend path /api /api/* /swagger /swagger/*

    handle @backend {
        reverse_proxy api-portal:8080 {
            header_up X-Portal-Frontend "APP-BO"
