# Copiază acest fișier ca .env și înlocuiește toate valorile PLACEHOLDER.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DMS_DB_PASSWORD=CHANGE_ME_DMS_DATABASE_PASSWORD
PORTAL_DB_PASSWORD=CHANGE_ME_PORTAL_DATABASE_PASSWORD

# Fiecare cheie trebuie să aibă cel puțin 32 de caractere aleatorii.
DMS_JWT_SIGNING_KEY=CHANGE_ME_DMS_JWT_SIGNING_KEY_AT_LEAST_32_CHARACTERS
PORTAL_JWT_SIGNING_KEY=CHANGE_ME_PORTAL_JWT_SIGNING_KEY_AT_LEAST_32_CHARACTERS
PORTAL_DMS_SHARED_SECRET=CHANGE_ME_SHARED_SECRET_AT_LEAST_32_CHARACTERS
DMS_FILE_DOWNLOAD_SIGNING_KEY=CHANGE_ME_DMS_FILE_KEY_AT_LEAST_32_CHARACTERS
PORTAL_FILE_DOWNLOAD_SIGNING_KEY=CHANGE_ME_PORTAL_FILE_KEY_AT_LEAST_32_CHARACTERS

# Trebuie să coincidă cu parola aleasă la generarea certs/aspnetapp.pfx.
HTTPS_CERT_PASSWORD=CHANGE_ME_CERTIFICATE_PASSWORD
